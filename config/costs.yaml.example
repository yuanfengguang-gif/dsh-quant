# 交易成本口径（单边费率，按成交金额加权）
#
# 说明：
#   · 所有值都是「占成交金额的比例」，不是按票数平均
#   · 回测按「换手份额 × 成交金额」摊入：一次调仓换掉 turnover 比例的持仓，
#     等价于卖出 turnover + 买入 turnover 两笔成交
#   · 印花税按成交日查 stamp_duty_schedule（2023-08-28 由 0.1% 降为 0.05%）
#   · 最低佣金 5 元/笔属「逐笔」约束，回测不做逐笔金额模拟；资金规模小时需单独敏感性分析

commission: 0.00026        # 佣金 万2.6，双边
transfer_fee: 0.00001      # 过户费 0.001%，双边（沪深）
slippage: 0.001            # 滑点 0.1%，单边
min_commission: 5.0        # 最低佣金（元/笔），仅披露/敏感性用

# 印花税：卖出单边，按成交日分段
stamp_duty_schedule:
  - until: "2023-08-27"    # 含当日
    rate: 0.001            # 0.1%
  - since: "2023-08-28"
    rate: 0.0005           # 0.05%
