# 回测/验证窗口配置模板（复制为 backtest_window.yaml 后按需修改）
window:
  start: "2020-06-01"
  end: "2025-12-31"
  panel_load_start: "2019-01-01"
  robustness:
    enabled: false
    start: "2010-01-01"
    end: "2025-12-31"

filters:
  exclude_suspension: true
  exclude_qfq_suspect: true
  exclude_st: true
  bj_handling: "keep"     # keep / low_liquidity / exclude
